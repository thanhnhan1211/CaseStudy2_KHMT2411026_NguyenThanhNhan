MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/task_manager
PORT=3000
JWT_SECRET=doi_thanh_chuoi_bi_mat_dai_va_ngau_nhien
JWT_EXPIRES_IN=7d

# Gửi email (SMTP). Ví dụ Gmail: dùng "Mật khẩu ứng dụng" (App Password), không dùng mật khẩu đăng nhập
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_account@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=Task Manager <your_account@gmail.com>

# Nhắc việc tự động
REMINDER_ENABLED=true
REMINDER_HOURS=24
REMINDER_INTERVAL_MINUTES=60
APP_TIMEZONE=Asia/Ho_Chi_Minh
